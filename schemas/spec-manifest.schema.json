{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baixada.cards/spec/manifest/v1/schema.json",
  "title": "TrucoSpecManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "format",
    "version",
    "source",
    "rulesets",
    "corpora",
    "files"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/spec-manifest.schema.json"
    },
    "format": {
      "const": "truco-spec-manifest/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "const": "https://github.com/baixada-cards/truco-spec"
    },
    "rulesets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+-v[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "string",
            "pattern": "^rulesets/[a-z0-9-]+-v[0-9]+\\.md$"
          }
        }
      }
    },
    "corpora": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "exploration",
        "notation"
      ],
      "properties": {
        "engine": {
          "$ref": "#/$defs/corpus"
        },
        "exploration": {
          "$ref": "#/$defs/corpus"
        },
        "notation": {
          "$ref": "#/$defs/corpus"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "schema",
        "fixtures",
        "count"
      ],
      "properties": {
        "format": {
          "type": "string",
          "pattern": "^[a-z-]+-fixture/v[0-9]+$"
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z-]+/schemas/fixture\\.schema\\.json$"
        },
        "fixtures": {
          "type": "string",
          "pattern": "^[a-z-]+/fixtures$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
