{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baixada.cards/spec/truco-2p-v1/engine/game-state.schema.json",
  "title": "GameState",
  "description": "The exact, private state of one two-player Truco hand. This schema defines the serialized shape; rule-level consistency is enforced by the engine contract and fixture corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dealer",
    "next_player",
    "score",
    "hand_value",
    "turnup",
    "hands",
    "completed_rounds",
    "current_round",
    "pending_raise"
  ],
  "properties": {
    "dealer": {
      "$ref": "#/$defs/player"
    },
    "next_player": {
      "$ref": "#/$defs/nullablePlayer"
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "hand_value": {
      "$ref": "#/$defs/handValue"
    },
    "turnup": {
      "$ref": "#/$defs/cardFace"
    },
    "hands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "0",
        "1"
      ],
      "properties": {
        "0": {
          "$ref": "#/$defs/hand"
        },
        "1": {
          "$ref": "#/$defs/hand"
        }
      }
    },
    "completed_rounds": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/completedRound"
      }
    },
    "current_round": {
      "$ref": "#/$defs/currentRound"
    },
    "last_raised_by": {
      "$ref": "#/$defs/nullablePlayer"
    },
    "pending_raise": {
      "oneOf": [
        {
          "$ref": "#/$defs/pendingRaise"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/pendingDecision"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "player": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "nullablePlayer": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        0,
        1,
        null
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "0",
        "1"
      ],
      "properties": {
        "0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "handValue": {
      "type": "integer",
      "enum": [
        1,
        3,
        6,
        9,
        12
      ]
    },
    "rank": {
      "type": "string",
      "enum": [
        "4",
        "5",
        "6",
        "7",
        "Q",
        "J",
        "K",
        "A",
        "2",
        "3"
      ]
    },
    "suit": {
      "type": "string",
      "enum": [
        "DIAMONDS",
        "SPADES",
        "HEARTS",
        "CLUBS"
      ]
    },
    "cardFace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "suit"
      ],
      "properties": {
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "suit": {
          "$ref": "#/$defs/suit"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "suit"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "rank": {
          "$ref": "#/$defs/rank"
        },
        "suit": {
          "$ref": "#/$defs/suit"
        }
      }
    },
    "hand": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player",
        "visibility",
        "card"
      ],
      "properties": {
        "player": {
          "$ref": "#/$defs/player"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      }
    },
    "completedRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leader",
        "winner"
      ],
      "properties": {
        "leader": {
          "$ref": "#/$defs/player"
        },
        "winner": {
          "$ref": "#/$defs/nullablePlayer"
        },
        "plays": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/play"
          }
        }
      }
    },
    "currentRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leader",
        "plays"
      ],
      "properties": {
        "leader": {
          "$ref": "#/$defs/player"
        },
        "plays": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/play"
          }
        }
      }
    },
    "pendingRaise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raised_by",
        "to",
        "previous_value"
      ],
      "properties": {
        "raised_by": {
          "$ref": "#/$defs/player"
        },
        "to": {
          "type": "integer",
          "enum": [
            3,
            6,
            9,
            12
          ]
        },
        "previous_value": {
          "type": "integer",
          "enum": [
            1,
            3,
            6,
            9
          ]
        }
      }
    },
    "pendingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "player"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "mao_de_onze"
        },
        "player": {
          "$ref": "#/$defs/player"
        }
      }
    }
  }
}
